# ── Required ────────────────────────────────────────────────────────────────
# Credentials for the existing VoiceMem runtime.
OPENAI_API_KEY=

# Access keys for this deployment (comma separated, 16+ characters each).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to start without it. Remove a key to revoke it and its sessions.
VOICEMEM_API_KEYS=

# ── Runtime ─────────────────────────────────────────────────────────────────
# "llm_tts" works with any OpenAI-compatible chat + TTS. "realtime" needs Realtime access.
DEMO_MODE=llm_tts
VOICEMEM_SPACE=demo
VOICEMEM_MEMORY_LANGUAGE=en
VOICEMEM_FILE_LOG=0

# Persistent data. Docker/Render mount this at /var/lib/voicemem (set in the image).
VOICEMEM_MEMORYSPACE_ROOT=/var/lib/voicemem/voicemem_memoryspace

# ── Security (defaults shown) ───────────────────────────────────────────────
# Extra browser origins allowed to call the API (same-origin is always allowed).
# VOICEMEM_ALLOWED_ORIGINS=https://app.example.com
# VOICEMEM_RATE_LIMIT_PER_MIN=120
# VOICEMEM_LOGIN_LIMIT_PER_MIN=10
# VOICEMEM_MAX_WS_PER_CLIENT=4
# VOICEMEM_MAX_BODY_BYTES=1000000
# VOICEMEM_MAX_WS_MESSAGE_BYTES=1000000
# Interactive API docs at /api-docs (needs a key). Off by default.
# VOICEMEM_ENABLE_DOCS=1

# Trust X-Forwarded-For only from your reverse proxy, or every user will share one
# rate-limit bucket (the proxy's address). Use the proxy's IP, or * if the container is
# reachable ONLY through the proxy (as on Render).
# FORWARDED_ALLOW_IPS=*

# ── Logging ─────────────────────────────────────────────────────────────────
# json (default) or text
# VOICEMEM_LOG_FORMAT=json
# VOICEMEM_LOG_LEVEL=INFO

# NEVER local development only. Turns authentication off.
# VOICEMEM_AUTH_DISABLED=1
