# Required for the existing VoiceMem runtime.
OPENAI_API_KEY=

# Use "llm_tts" for the broadest compatibility.
# Use "realtime" only when the configured OpenAI account/model has Realtime access.
DEMO_MODE=llm_tts

# Persistent runtime data. Render/Docker should mount this path to a durable disk.
VOICEMEM_MEMORYSPACE_ROOT=/var/lib/voicemem/voicemem_memoryspace

# Optional model/runtime tuning.
VOICEMEM_SPACE=demo
VOICEMEM_MEMORY_LANGUAGE=en
VOICEMEM_FILE_LOG=0
